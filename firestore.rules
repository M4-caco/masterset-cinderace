rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Profiles must be stored at users_data/{Firebase Auth UID}.
    // The previous cinderace_masterset document is retained as a backup
    // for a one-time ADMIN-SDK migration. No browser can read or write it.
    match /users_data/{userId} {
      allow read, write: if request.auth != null
                         && request.auth.uid == userId
                         && userId != 'cinderace_masterset';
    }

    // All other documents remain private by default.
  }
}
